# ─────────────────────────────────────────────────────────────
# FreightGuard Defense — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── RESEND EMAIL ──────────────────────────────────────────────
# Get from: https://resend.com → API Keys
# Primary email delivery (preferred over SMTP)
RESEND_API_KEY=re_RfBRykVq_HCmoWiyWcD92MGcuXMDtvfPq
RESEND_FROM_EMAIL=noreply@freightguarddefense.com

# ── SMTP FALLBACK ─────────────────────────────────────────────
# Used only if Resend is not configured
# Gmail: use an App Password — NOT your regular password
# Guide: Google Account → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# SendGrid alternative:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.YOUR_SENDGRID_API_KEY

# ── GOOGLE MAPS ───────────────────────────────────────────────
# Get from: https://console.cloud.google.com
# Enable: Geocoding API + Places API (Text Search)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ── STRIPE PAYMENTS ───────────────────────────────────────────
# Currently DISABLED — set STRIPE_DISABLED=true to keep bypassed
# Get from: https://dashboard.stripe.com → Developers → API Keys
STRIPE_DISABLED=true
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
# Price in cents — 25000 = $250.00
STRIPE_PRICE_AMOUNT=25000

# ── ADMIN ─────────────────────────────────────────────────────
# Password for the /admin.html control panel
# Default if not set: mikee@megafleetcorp.com
ADMIN_PASSWORD=mikee@megafleetcorp.com

# ── BRANDING ──────────────────────────────────────────────────
FIRM_NAME=FreightGuard Defense Legal Network

# ── DEPLOYMENT ────────────────────────────────────────────────
# Your live URL — used for Stripe redirect after payment
# No trailing slash. Example: https://freightguarddefense.com
BASE_URL=http://localhost:3000

# Port — Railway/Render override this automatically
PORT=3000
